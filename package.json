{
  "name": "tabbed-card",
  "version": "0.4.0-beta.4",
  "description": "a custom card for home assistant that utilizes tabs to segregate individual cards.",
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "automation",
    "lovelace",
    "custom-cards"
  ],
  "scripts": {
    "build": "tsc && vite build --emptyOutDir false",
    "build:no-check": "vite build --emptyOutDir false",
    "watch": "vite build --mode development",
    "test": "node scripts/compile-tests.mjs && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check:hacs": "node scripts/check-package.mjs",
    "package": "node scripts/package-candidate.mjs",
    "dev": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@material/mwc-tab": "^0.27.0",
    "@material/mwc-tab-bar": "^0.27.0",
    "custom-card-helpers": "^1.9.0",
    "lit": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^18.11.18",
    "happy-dom": "21.0.3",
    "typescript": "^4.9.4",
    "vite": "^4.0.4"
  },
  "packageManager": "pnpm@11.25.0"
}
